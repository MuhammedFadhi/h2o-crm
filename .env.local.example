# Copy this file to `.env.local` (gitignored) and fill in your real values.
# DO NOT commit the populated .env.local file.

# ─── Supabase ────────────────────────────────────────────────────────
# Project URL + anon (publishable) key + service_role (secret) key
# from Supabase Dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# ─── LLM provider (for YouTube + WhatsApp + Instagram AI replies) ────
# Set ONE of these. The code auto-picks the first one set in this order:
#   1. ANTHROPIC_API_KEY  → Claude (paid, very fast)
#   2. GOOGLE_AI_API_KEY  → Gemini (FREE 1500/day, fast)
#   3. OPENAI_API_KEY     → OpenAI
#   4. OPENROUTER_API_KEY → OpenRouter
#
# Option A: Google Gemini — FREE, fast, recommended
# Get key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=AIzaSy_paste_your_gemini_key_here
LLM_MODEL=gemini-2.0-flash
#
# Option B: Anthropic Claude (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx
# LLM_MODEL=claude-haiku-4-5-20251001
#
# Option C: OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
#
# Option D: OpenRouter (https://openrouter.ai → Keys)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# LLM_MODEL=anthropic/claude-3.5-sonnet
#
# Advanced: force a custom endpoint (e.g. self-hosted proxy)
# LLM_API_URL=https://my-llm-proxy.example.com/v1/chat/completions

# ─── Audio transcoding (WhatsApp voice notes) ────────────────────────
# Converts uploaded/recorded audio to MP3 before sending via WhatsApp.
# Get a free API key at: https://cloudconvert.com → Dashboard → API Keys
CLOUDCONVERT_API_KEY=replace-with-your-cloudconvert-api-key

# ─── OAuth token encryption key ──────────────────────────────────────
# Used to encrypt OAuth refresh tokens before storing them in Supabase.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

# ─── App base URL ────────────────────────────────────────────────────
# Used for OAuth redirect callbacks and WhatsApp webhook URL display.
APP_BASE_URL=https://crm.a3sixty.com

# ─── Google / YouTube OAuth (OPTIONAL until you connect YouTube) ─────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Shared tenant ───────────────────────────────────────────────────
# All logins share one CRM dataset, scoped by this fixed user id rather
# than whoever is currently logged in. Use the id of your original/main
# account (Supabase Dashboard → Authentication → Users, or:
#   select id, email, created_at from auth.users order by created_at asc;
# in the SQL editor — pick the oldest row).
TENANT_ID=13cdf882-eebf-464b-81e5-c3dcb8534cf3

# ─── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010

# ────────────────────────────────────────────────────────────────────
# WhatsApp Cloud API credentials are stored PER USER in the database
# (not env vars). Users paste them via the Settings page after signup.
# Webhook URL to register in Meta Developer Dashboard:
#   <APP_BASE_URL>/api/v1/whatsapp/webhook
# ────────────────────────────────────────────────────────────────────
